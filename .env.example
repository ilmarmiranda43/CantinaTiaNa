# Aplicação Python
APP_NAME=Cantina Escolar
ENVIRONMENT=development
SECRET_KEY=gere-uma-chave-grande-e-aleatoria
DATABASE_URL=postgresql://cantina:cantina@localhost:5432/cantina
FORCE_HTTPS_COOKIE=false

# Usado apenas para criar o primeiro administrador em um banco vazio.
# Depois da primeira inicialização, remova ADMIN_PASSWORD do ambiente.
ADMIN_EMAIL=admin@cantina.local
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Integração interna com o serviço Baileys
WHATSAPP_SERVICE_URL=http://localhost:3001
WHATSAPP_API_KEY=troque-por-a-mesma-chave-do-servico-node
WHATSAPP_SESSION_ID=cantina-principal
WHATSAPP_TIMEOUT_SECONDS=15

